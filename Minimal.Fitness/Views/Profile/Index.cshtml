@model Minimal.Fitness.Models.UserProfile
@using Minimal.Fitness.Models.Enums
@{
    ViewData["Title"] = "Profile";
}

<h2>Profile</h2>

@if (TempData["Message"] != null)
{
    <div class="alert alert-success">@TempData["Message"]</div>
}

<form asp-action="Update" method="post" class="col-md-6">
    <div class="mb-3">
        <label class="form-label">Gender</label>
        <select name="gender" class="form-select">
            @foreach (Gender g in Enum.GetValues<Gender>())
            {
                <option value="@g" selected="@(Model.Gender == g)">@g</option>
            }
        </select>
    </div>
    <div class="mb-3">
        <label class="form-label">Default Rest Time: <span id="rest-display">@Model.DefaultRestSeconds</span>s</label>
        <input type="range" name="defaultRestSeconds" class="form-range"
               min="15" max="180" step="5" value="@Model.DefaultRestSeconds"
               oninput="document.getElementById('rest-display').textContent=this.value" />
    </div>
    <button type="submit" class="btn btn-primary">Save</button>
</form>
