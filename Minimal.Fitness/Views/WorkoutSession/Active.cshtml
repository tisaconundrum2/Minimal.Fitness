@model Minimal.Fitness.Models.SessionExercise
@using Minimal.Fitness.Models.Enums
@{
    ViewData["Title"] = Model.Exercise.Name;
    Layout = null;

    var sessionId = (int)ViewBag.SessionId;
    var exerciseIndex = (int)ViewBag.ExerciseIndex;
    var total = (int)ViewBag.TotalExercises;
    var pe = (Minimal.Fitness.Models.WorkoutPlanExercise)ViewBag.PlanExercise;
    var restSeconds = (int)ViewBag.DefaultRestSeconds;
    var completedSets = Model.Sets.Count;
    var totalSets = pe?.DefaultSets ?? 3;
    var isTimer = Model.Exercise.TrackingType == TrackingType.Timer;
    var isLastExercise = exerciseIndex == total - 1;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>@Model.Exercise.Name - Workout</title>
    <meta name="theme-color" content="#111" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <style>
        * { box-sizing: border-box; }

        body {
            margin: 0;
            background: #f4f4f4;
            color: #111;
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
            -webkit-font-smoothing: antialiased;
        }

        button, input { font: inherit; -webkit-tap-highlight-color: transparent; }

        .workout-screen {
            width: 100%;
            max-width: 430px;
            min-height: 100svh;
            margin: 0 auto;
            padding: 0 24px 40px;
            background: #fff;
            display: flex;
            flex-direction: column;
        }

        /* Progress bar */
        .progress-strip {
            position: sticky;
            top: 0;
            z-index: 10;
            background: #fff;
            padding: 12px 0 8px;
        }
        .progress-track {
            height: 6px;
            background: #e5e7eb;
            border-radius: 3px;
            overflow: hidden;
        }
        .progress-fill {
            height: 100%;
            background: #111;
            border-radius: 3px;
            transition: width 0.3s ease;
        }
        .progress-label {
            font-size: 13px;
            color: #888;
            margin-top: 4px;
            text-align: center;
        }

        /* Animation area */
        .animation {
            width: 100%;
            aspect-ratio: 1;
            margin: 8px auto 0;
            background: #1a1a2e;
            border-radius: 20px;
            overflow: hidden;
            display: flex;
            align-items: center;
            justify-content: center;
        }
        .animation img {
            width: 100%;
            height: 100%;
            object-fit: contain;
        }
        .animation .frame-swap {
            position: relative;
            width: 100%;
            height: 100%;
        }
        .animation .frame-swap img {
            position: absolute;
            inset: 0;
        }
        /* 1→2→3→2 loop: 4 beats × 0.7s = 2.8s */
        .animation .frame-swap img:nth-child(1) {
            animation: frame-a 2.8s steps(1) infinite;
        }
        .animation .frame-swap img:nth-child(2) {
            animation: frame-b 2.8s steps(1) infinite;
        }
        .animation .frame-swap img:nth-child(3) {
            animation: frame-c 2.8s steps(1) infinite;
        }
        @@keyframes frame-a {
            0%, 25% { opacity: 1; }
            25.01%, 100% { opacity: 0; }
        }
        @@keyframes frame-b {
            0%, 25% { opacity: 0; }
            25.01%, 50% { opacity: 1; }
            50.01%, 75% { opacity: 0; }
            75.01%, 100% { opacity: 1; }
        }
        @@keyframes frame-c {
            0%, 50% { opacity: 0; }
            50.01%, 75% { opacity: 1; }
            75.01%, 100% { opacity: 0; }
        }
        .animation-placeholder {
            font-size: 5rem;
            color: #ccc;
        }

        /* Exercise name */
        .exercise-name {
            font-size: 22px;
            font-weight: 700;
            text-align: center;
            margin: 20px 0 4px;
        }
        .exercise-section {
            font-size: 13px;
            color: #888;
            text-align: center;
            text-transform: uppercase;
            letter-spacing: 0.05em;
        }

        /* Workout table */
        .workout-table {
            width: 100%;
            margin-top: clamp(20px, 5svh, 40px);
            border-collapse: collapse;
            text-align: left;
            font-size: 16px;
        }
        .workout-table th,
        .workout-table td {
            padding: 14px 8px;
            border-bottom: 1px solid #e5e7eb;
            white-space: nowrap;
        }
        .workout-table th { font-weight: 700; }
        .workout-table th:last-child,
        .workout-table td:last-child { text-align: right; }
        .workout-table th:nth-child(2),
        .workout-table td:nth-child(2) { text-align: center; }

        /* Set tracking row */
        .set-row { cursor: pointer; }
        .set-row.completed { opacity: 0.5; text-decoration: line-through; }
        .set-row.active-set { background: #f0f7ff; font-weight: 600; }
        .set-check { width: 20px; }

        /* Difficulty buttons */
        .difficulty {
            display: grid;
            gap: 14px;
            width: min(100%, 280px);
            margin: 28px auto 0;
            padding: 0;
        }
        .difficulty button {
            min-height: 60px;
            border: 2px solid currentColor;
            border-radius: 16px;
            font-size: 18px;
            font-weight: 600;
            cursor: pointer;
            transition: transform 150ms ease, box-shadow 150ms ease;
        }
        .difficulty button:active { transform: scale(0.97); }
        .difficulty button:focus-visible {
            outline: 3px solid #222;
            outline-offset: 4px;
        }
        .difficulty button[aria-pressed="true"] {
            box-shadow: 0 0 0 3px #fff, 0 0 0 5px currentColor;
        }
        .btn-hard { background: #ffcaca; color: #e63236; }
        .btn-madeit { background: #ffeda0; color: #ec9000; }
        .btn-easy { background: #b0efb9; color: #299e45; }

        /* Timer display */
        .timer-display {
            font-size: 4rem;
            font-weight: 700;
            text-align: center;
            font-variant-numeric: tabular-nums;
            margin: 12px 0;
        }
        .timer-controls {
            display: flex;
            gap: 12px;
            justify-content: center;
        }
        .timer-controls button {
            min-width: 100px;
            min-height: 48px;
            border: 2px solid #111;
            border-radius: 12px;
            background: #fff;
            font-weight: 600;
            cursor: pointer;
        }
        .timer-controls button.primary {
            background: #111;
            color: #fff;
        }

        /* Rest overlay */
        .rest-overlay {
            position: fixed;
            inset: 0;
            background: rgba(0,0,0,0.9);
            z-index: 100;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            color: #fff;
        }
        .rest-overlay.hidden { display: none; }
        .rest-title {
            font-size: 16px;
            text-transform: uppercase;
            letter-spacing: 0.1em;
            opacity: 0.7;
            margin-bottom: 8px;
        }
        .rest-timer {
            font-size: 6rem;
            font-weight: 700;
            font-variant-numeric: tabular-nums;
        }
        .rest-ring {
            width: 200px;
            height: 200px;
        }
        .rest-ring circle {
            fill: none;
            stroke-width: 6;
        }
        .rest-ring .track { stroke: #333; }
        .rest-ring .fill {
            stroke: #fff;
            stroke-linecap: round;
            transition: stroke-dashoffset 1s linear;
            transform: rotate(-90deg);
            transform-origin: center;
        }
        .rest-skip {
            margin-top: 32px;
            padding: 12px 40px;
            border: 2px solid rgba(255,255,255,0.3);
            border-radius: 12px;
            background: none;
            color: #fff;
            font-size: 16px;
            font-weight: 600;
            cursor: pointer;
        }

        /* Done button */
        .done-btn {
            width: 100%;
            max-width: 280px;
            min-height: 56px;
            margin: 20px auto 0;
            display: block;
            border: none;
            border-radius: 14px;
            background: #111;
            color: #fff;
            font-size: 18px;
            font-weight: 600;
            cursor: pointer;
        }
        .done-btn:disabled { opacity: 0.3; cursor: not-allowed; }

        /* Reps/weight inputs */
        .inline-input {
            width: 60px;
            text-align: center;
            border: 1px solid #ddd;
            border-radius: 8px;
            padding: 6px;
            font-size: 16px;
            font-weight: 600;
        }
        .inline-input:focus {
            outline: 2px solid #111;
            border-color: #111;
        }

        @@media (prefers-reduced-motion: reduce) {
            .difficulty button { transition: none; }
        }
    </style>
</head>
<body>
    <main class="workout-screen" aria-label="Active workout">
        <!-- Progress -->
        <div class="progress-strip">
            <div class="progress-track">
                <div class="progress-fill" style="width: @((exerciseIndex * 100) / total)%"></div>
            </div>
            <div class="progress-label">@ViewBag.PlanName &mdash; @(exerciseIndex + 1) of @total</div>
        </div>

        <!-- Animation -->
        @{
            var cdnBase = "https://cdn.jsdelivr.net/npm/@bryllim/workout-guide@1.0.0/assets";
            var slug = Model.Exercise.AnimationPath;
        }
        <div class="animation" role="img" aria-label="@Model.Exercise.Name demonstration">
            @if (slug != null)
            {
                <div class="frame-swap">
                    <img src="@cdnBase/@slug/frame-1.png" alt="" />
                    <img src="@cdnBase/@slug/frame-2.png" alt="" />
                    <img src="@cdnBase/@slug/frame-3.png" alt="" />
                </div>
            }
            else
            {
                <div class="animation-placeholder">🏋️</div>
            }
        </div>

        <!-- Exercise info -->
        @if (pe != null)
        {
            <div class="exercise-section">@pe.Section</div>
        }
        <div class="exercise-name">@Model.Exercise.Name</div>

        @if (isTimer)
        {
            <!-- Timer mode -->
            <div id="timer-area">
                <table class="workout-table" aria-label="Exercise target">
                    <thead>
                        <tr>
                            <th></th>
                            <th>Set</th>
                            <th>Duration</th>
                        </tr>
                    </thead>
                    <tbody>
                        @for (int s = 1; s <= totalSets; s++)
                        {
                            var done = Model.Sets.Any(x => x.SetNumber == s);
                            <tr class="set-row @(done ? "completed" : "") @(!done && !Model.Sets.Any(x => x.SetNumber == s) && s == completedSets + 1 ? "active-set" : "")"
                                data-set="@s" data-done="@done.ToString().ToLower()">
                                <td class="set-check">@(done ? "✓" : "")</td>
                                <td>@s of @totalSets</td>
                                <td style="text-align:right">@(pe?.DefaultDurationSeconds ?? 60)s</td>
                            </tr>
                        }
                    </tbody>
                </table>

                @if (completedSets < totalSets)
                {
                    <div class="timer-display" id="timer-display">@(pe?.DefaultDurationSeconds ?? 60)</div>
                    <div class="timer-controls">
                        <button type="button" id="timer-start" class="primary">Start</button>
                        <button type="button" id="timer-reset">Reset</button>
                    </div>
                }
            </div>
        }
        else
        {
            <!-- Reps mode -->
            <table class="workout-table" aria-label="Exercise target">
                <thead>
                    <tr>
                        <th></th>
                        <th>Sets</th>
                        <th>Target</th>
                        <th>Weight</th>
                    </tr>
                </thead>
                <tbody>
                    @for (int s = 1; s <= totalSets; s++)
                    {
                        var existingSet = Model.Sets.FirstOrDefault(x => x.SetNumber == s);
                        var done = existingSet != null;
                        var isActive = s == completedSets + 1 && !done;
                        <tr class="set-row @(done ? "completed" : "") @(isActive ? "active-set" : "")"
                            data-set="@s" data-done="@done.ToString().ToLower()">
                            <td class="set-check">@(done ? "✓" : "")</td>
                            <td>@s of @totalSets</td>
                            <td>
                                @if (isActive)
                                {
                                    <input type="number" class="inline-input" id="reps-@s"
                                           value="@(pe?.DefaultReps ?? 10)" min="0" max="999" inputmode="numeric" />
                                    <span>reps</span>
                                }
                                else if (done)
                                {
                                    @($"{existingSet!.Reps} reps")
                                }
                                else
                                {
                                    @($"{pe?.DefaultReps} reps")
                                }
                            </td>
                            <td style="text-align:right">
                                @if (isActive && pe?.DefaultWeight.HasValue == true)
                                {
                                    <input type="number" class="inline-input" id="weight-@s"
                                           value="@pe.DefaultWeight" min="0" max="9999" step="2.5" inputmode="decimal" />
                                    <span>lbs</span>
                                }
                                else if (done && existingSet!.Weight.HasValue)
                                {
                                    @($"{existingSet.Weight:F1} lbs")
                                }
                                else if (pe?.DefaultWeight.HasValue == true)
                                {
                                    @($"{pe.DefaultWeight:F1} lbs")
                                }
                                else
                                {
                                    <text>—</text>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }

        <!-- Done / complete set button -->
        @if (completedSets < totalSets)
        {
            <button type="button" class="done-btn" id="complete-set-btn">
                Done &mdash; Set @(completedSets + 1)
            </button>
        }

        <!-- Difficulty (shown when all sets done) -->
        @if (completedSets >= totalSets)
        {
            <div class="difficulty">
                <form asp-action="RateExercise" method="post">
                    <input type="hidden" name="sessionExerciseId" value="@Model.Id" />
                    <input type="hidden" name="sessionId" value="@sessionId" />
                    <input type="hidden" name="nextIndex" value="@(exerciseIndex + 1)" />
                    <div class="difficulty" style="margin:0;">
                        <button type="submit" name="difficulty" value="Struggled" class="btn-hard" aria-pressed="false">
                            Hard
                        </button>
                        <button type="submit" name="difficulty" value="GotIt" class="btn-madeit" aria-pressed="false">
                            Made it
                        </button>
                        <button type="submit" name="difficulty" value="TooEasy" class="btn-easy" aria-pressed="false">
                            Easy
                        </button>
                    </div>
                </form>
            </div>
        }

        <!-- Rest overlay -->
        <div class="rest-overlay hidden" id="rest-overlay" aria-live="assertive">
            <div class="rest-title">Rest</div>
            <svg class="rest-ring" viewBox="0 0 200 200">
                <circle class="track" cx="100" cy="100" r="90"/>
                <circle class="fill" id="rest-ring-fill" cx="100" cy="100" r="90"
                        stroke-dasharray="565.49" stroke-dashoffset="0"/>
            </svg>
            <div class="rest-timer" id="rest-timer-display">@restSeconds</div>
            <button type="button" class="rest-skip" id="rest-skip">Skip</button>
        </div>
    </main>

    <script src="~/js/screen-wake.js"></script>
    <script>
        (function () {
            // Keep screen awake during active workout & rest periods
            ScreenWake.enable('ActiveWorkout');

            const sessionExerciseId = @Model.Id;
            const currentSet = @(completedSets + 1);
            const totalSets = @totalSets;
            const isTimer = @(isTimer ? "true" : "false");
            const timerDuration = @(pe?.DefaultDurationSeconds ?? 60);
            const restDuration = @restSeconds;
            const sessionId = @sessionId;
            const exerciseIndex = @exerciseIndex;
            const antiForgeryToken = '@Html.AntiForgeryToken()'.match(/value="([^"]+)"/)?.[1] ?? '';

            // Complete set via AJAX
            const completeBtn = document.getElementById('complete-set-btn');
            if (completeBtn) {
                completeBtn.addEventListener('click', async () => {
                    completeBtn.disabled = true;
                    const body = new URLSearchParams();
                    body.set('sessionExerciseId', sessionExerciseId);
                    body.set('setNumber', currentSet);
                    body.set('__RequestVerificationToken', antiForgeryToken);

                    if (isTimer) {
                        body.set('durationSeconds', timerDuration);
                    } else {
                        const repsEl = document.getElementById('reps-' + currentSet);
                        const weightEl = document.getElementById('weight-' + currentSet);
                        if (repsEl) body.set('reps', repsEl.value);
                        if (weightEl) body.set('weight', weightEl.value);
                    }

                    const res = await fetch('@Url.Action("CompleteSet")', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                        body: body
                    });

                    if (res.ok) {
                        if (currentSet < totalSets) {
                            showRestTimer();
                        } else {
                            window.location.href = '@Url.Action("Active", new { sessionId })' +
                                '&exerciseIndex=' + exerciseIndex;
                        }
                    }
                });
            }

            // Exercise timer
            const timerDisplay = document.getElementById('timer-display');
            const startBtn = document.getElementById('timer-start');
            const resetBtn = document.getElementById('timer-reset');
            let timerInterval = null;
            let timerRemaining = timerDuration;

            if (startBtn) {
                startBtn.addEventListener('click', () => {
                    if (timerInterval) {
                        clearInterval(timerInterval);
                        timerInterval = null;
                        startBtn.textContent = 'Start';
                        return;
                    }
                    startBtn.textContent = 'Pause';
                    timerInterval = setInterval(() => {
                        timerRemaining--;
                        timerDisplay.textContent = timerRemaining;
                        if (timerRemaining <= 0) {
                            clearInterval(timerInterval);
                            timerInterval = null;
                            beep();
                            if (completeBtn) completeBtn.click();
                        }
                    }, 1000);
                });
            }
            if (resetBtn) {
                resetBtn.addEventListener('click', () => {
                    clearInterval(timerInterval);
                    timerInterval = null;
                    timerRemaining = timerDuration;
                    timerDisplay.textContent = timerRemaining;
                    if (startBtn) startBtn.textContent = 'Start';
                });
            }

            // Rest timer
            const restOverlay = document.getElementById('rest-overlay');
            const restDisplay = document.getElementById('rest-timer-display');
            const restRingFill = document.getElementById('rest-ring-fill');
            const restSkip = document.getElementById('rest-skip');
            const circumference = 2 * Math.PI * 90; // r=90
            let restInterval = null;

            function showRestTimer() {
                restOverlay.classList.remove('hidden');
                let remaining = restDuration;
                restDisplay.textContent = remaining;
                restRingFill.style.strokeDashoffset = '0';

                restInterval = setInterval(() => {
                    remaining--;
                    restDisplay.textContent = remaining;
                    const offset = circumference * (1 - remaining / restDuration);
                    restRingFill.style.strokeDashoffset = offset;

                    if (remaining <= 0) {
                        clearInterval(restInterval);
                        beep();
                        dismissRest();
                    }
                }, 1000);
            }

            function dismissRest() {
                if (restInterval) clearInterval(restInterval);
                restOverlay.classList.add('hidden');
                // Reload to show next set
                window.location.href = '@Url.Action("Active", new { sessionId })' +
                    '&exerciseIndex=' + exerciseIndex;
            }

            if (restSkip) {
                restSkip.addEventListener('click', dismissRest);
            }

            // Audio beep
            function beep() {
                try {
                    const ctx = new (window.AudioContext || window.webkitAudioContext)();
                    const osc = ctx.createOscillator();
                    const gain = ctx.createGain();
                    osc.connect(gain);
                    gain.connect(ctx.destination);
                    osc.frequency.value = 880;
                    gain.gain.value = 0.3;
                    osc.start();
                    osc.stop(ctx.currentTime + 0.15);
                    setTimeout(() => {
                        const osc2 = ctx.createOscillator();
                        const gain2 = ctx.createGain();
                        osc2.connect(gain2);
                        gain2.connect(ctx.destination);
                        osc2.frequency.value = 880;
                        gain2.gain.value = 0.3;
                        osc2.start();
                        osc2.stop(ctx.currentTime + 0.15);
                    }, 200);
                } catch (e) { /* audio not available */ }
            }
        })();
    </script>
</body>
</html>
