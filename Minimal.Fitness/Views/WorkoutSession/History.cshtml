@model IEnumerable<Minimal.Fitness.Models.WorkoutSession>
@{
    ViewData["Title"] = "Workout History";
}

<h2>Workout History</h2>

@if (!Model.Any())
{
    <p class="text-muted">No workouts yet. <a asp-controller="WorkoutPlans" asp-action="Index">Start one!</a></p>
}
else
{
    <div class="list-group">
        @foreach (var s in Model)
        {
            var duration = (s.CompletedAtUtc ?? s.StartedAtUtc) - s.StartedAtUtc;
            <a asp-action="Summary" asp-route-sessionId="@s.Id" class="list-group-item list-group-item-action">
                <div class="d-flex justify-content-between">
                    <strong>@s.WorkoutPlan.Name</strong>
                    <small class="text-muted">@s.StartedAtUtc.ToLocalTime().ToString("MMM d, yyyy")</small>
                </div>
                <small class="text-muted">
                    @s.Exercises.Count exercises &middot;
                    @duration.TotalMinutes.ToString("F0") min
                    @if (s.CompletedAtUtc == null) { <span class="badge bg-warning text-dark">In Progress</span> }
                </small>
            </a>
        }
    </div>
}
