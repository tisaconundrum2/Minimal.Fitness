@model Minimal.Fitness.Models.WorkoutSession
@using Minimal.Fitness.Models.Enums
@using Minimal.Fitness.Models
@{
    ViewData["Title"] = "Workout Complete";
    var lastSetTime = Model.Exercises
        .SelectMany(e => e.Sets)
        .Select(s => s.CompletedAtUtc)
        .DefaultIfEmpty(Model.StartedAtUtc)
        .Max();
    var endTime = new[] { lastSetTime, Model.CompletedAtUtc ?? lastSetTime }.Min();
    if (endTime < Model.StartedAtUtc) endTime = Model.StartedAtUtc;
    var duration = endTime - Model.StartedAtUtc;

    var planExercises = (Dictionary<int, WorkoutPlanExercise>)ViewBag.PlanExercises;
    var bumpSuggestions = (Dictionary<int, int>)ViewBag.BumpSuggestions;
}

<div class="text-center py-4">
    <h2>Workout Complete! 💪</h2>
    <p class="text-muted">@Model.WorkoutPlan.Name &mdash; @duration.TotalMinutes.ToString("F0") min</p>
</div>

<table class="table">
    <thead>
        <tr>
            <th>Exercise</th>
            <th>Sets</th>
            <th>Feeling</th>
            <th>Weight</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var se in Model.Exercises)
        {
            var hasPlanExercise = planExercises.TryGetValue(se.ExerciseId, out var pe);
            var currentWeight = pe?.DefaultWeight;
            var bump = bumpSuggestions.GetValueOrDefault(se.ExerciseId);
            <tr style="@(se.Skipped ? "opacity:0.5" : "")">
                <td>@se.Exercise.Name</td>
                <td>@(se.Skipped ? "Skipped" : se.Sets.Count.ToString())</td>
                <td>
                    @if (se.Skipped)
                    {
                        <span class="badge" style="background:#e5e7eb;color:#666">Skipped</span>
                    }
                    else
                    {
                        @switch (se.Difficulty)
                        {
                            case Difficulty.TooEasy:
                                <span class="badge" style="background:#b0efb9;color:#299e45">Easy</span>
                                break;
                            case Difficulty.GotIt:
                                <span class="badge" style="background:#ffeda0;color:#ec9000">Made it</span>
                                break;
                            case Difficulty.Struggled:
                                <span class="badge" style="background:#ffcaca;color:#e63236">Hard</span>
                                break;
                            default:
                                <span class="text-muted">—</span>
                                break;
                        }
                    }
                </td>
                <td>
                    @if (currentWeight.HasValue && currentWeight > 0)
                    {
                        <span>@currentWeight lbs</span>
                    }
                    else
                    {
                        <span class="text-muted">—</span>
                    }
                </td>
                <td>
                    @if (hasPlanExercise && !se.Skipped)
                    {
                        <div class="d-flex gap-1 align-items-center">
                            @if (bump >= 1)
                            {
                                <form asp-action="BumpWeight" method="post" class="d-inline">
                                    <input type="hidden" name="sessionId" value="@Model.Id" />
                                    <input type="hidden" name="workoutPlanExerciseId" value="@pe!.Id" />
                                    <input type="hidden" name="direction" value="1" />
                                    <button type="submit" class="btn btn-sm btn-success" title="Bump up 5 lbs for next time">
                                        ↑ +5 lbs
                                    </button>
                                </form>
                            }
                            @if (bump <= -1)
                            {
                                <form asp-action="BumpWeight" method="post" class="d-inline">
                                    <input type="hidden" name="sessionId" value="@Model.Id" />
                                    <input type="hidden" name="workoutPlanExerciseId" value="@pe!.Id" />
                                    <input type="hidden" name="direction" value="-1" />
                                    <button type="submit" class="btn btn-sm btn-danger" title="Bump down 5 lbs for next time">
                                        ↓ -5 lbs
                                    </button>
                                </form>
                            }
                            @if (bump == 0)
                            {
                                <span class="text-muted small">—</span>
                            }
                        </div>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>

<div class="d-flex gap-3 justify-content-center mt-4">
    <a asp-controller="WorkoutPlans" asp-action="Index" class="btn btn-outline-primary">Back to Plans</a>
    <a asp-action="History" class="btn btn-primary">View History</a>
</div>
