@model Minimal.Fitness.Models.Exercise
@{
    ViewData["Title"] = Model.Name;
}

<nav aria-label="breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-action="Index">Exercises</a></li>
        <li class="breadcrumb-item active">@Model.Name</li>
    </ol>
</nav>

@if (Model.AnimationPath != null)
{
    <div class="d-flex justify-content-center mb-3" style="padding:16px">
        <img src="https://cdn.jsdelivr.net/npm/@@bryllim/workout-guide@@1.0.0/assets/@Model.AnimationPath/frame-1.png"
             alt="@Model.Name" class="exercise-img" style="max-width:300px;width:100%;padding:16px" />
    </div>
}
<h2>@Model.Name</h2>
<p><span class="badge bg-secondary">@Model.MuscleGroup</span>
   <span class="badge bg-info">@Model.TrackingType</span></p>

@if (Model.Description != null)
{
    <p>@Model.Description</p>
}
@if (Model.Equipment != null)
{
    <p><strong>Equipment:</strong> @Model.Equipment</p>
}
