@model IEnumerable<Minimal.Fitness.Models.Exercise>
@using Minimal.Fitness.Models.Enums
@{
    ViewData["Title"] = "Exercise Library";
}

<h2>Exercise Library</h2>

<div class="muscle-group-scroll mb-3">
    <a asp-action="Index" class="btn muscle-group-btn @(ViewBag.SelectedGroup == null ? "btn-primary active-filter" : "btn-outline-primary")">All</a>
    @foreach (MuscleGroup g in ViewBag.MuscleGroups)
    {
        <a asp-action="Index" asp-route-group="@g"
           class="btn muscle-group-btn @(ViewBag.SelectedGroup != null && (MuscleGroup)ViewBag.SelectedGroup == g ? "btn-primary active-filter" : "btn-outline-primary")">
            @g
        </a>
    }
</div>

<div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 g-3">
    @foreach (var ex in Model)
    {
        <div class="col">
            <a asp-action="Details" asp-route-id="@ex.Id" class="card exercise-card h-100 text-decoration-none text-body">
                @if (ex.AnimationPath != null)
                {
                    <div class="card-img-top frame-anim p-2" style="height:180px">
                        <img src="https://cdn.jsdelivr.net/npm/@@bryllim/workout-guide@@1.0.0/assets/@ex.AnimationPath/frame-1.png" alt="@ex.Name" />
                        <img src="https://cdn.jsdelivr.net/npm/@@bryllim/workout-guide@@1.0.0/assets/@ex.AnimationPath/frame-2.png" alt="" loading="lazy" />
                        <img src="https://cdn.jsdelivr.net/npm/@@bryllim/workout-guide@@1.0.0/assets/@ex.AnimationPath/frame-3.png" alt="" loading="lazy" />
                    </div>
                }
                <div class="card-body">
                    <h5 class="card-title">@ex.Name</h5>
                    <span class="badge bg-secondary">@ex.MuscleGroup</span>
                    <span class="badge @(ex.TrackingType == TrackingType.Timer ? "bg-info" : "bg-success")">
                        @(ex.TrackingType == TrackingType.Timer ? "⏱ Timer" : "Reps")
                    </span>
                    @if (ex.Equipment != null)
                    {
                        <small class="text-muted d-block mt-1">@ex.Equipment</small>
                    }
                </div>
            </a>
        </div>
    }
</div>

@section Scripts {
<script>
    document.addEventListener('DOMContentLoaded', function () {
        var active = document.querySelector('.muscle-group-scroll .active-filter');
        if (active) {
            active.scrollIntoView({ inline: 'center', block: 'nearest', behavior: 'instant' });
        }
    });
</script>
}
