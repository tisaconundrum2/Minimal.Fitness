@model IEnumerable<Minimal.Fitness.Models.Exercise>
@using Minimal.Fitness.Models.Enums
@{
    ViewData["Title"] = "Exercise Library";
}

<h2>Exercise Library</h2>

<div class="mb-3">
    <a asp-action="Index" class="btn btn-sm @(ViewBag.SelectedGroup == null ? "btn-primary" : "btn-outline-primary")">All</a>
    @foreach (MuscleGroup g in ViewBag.MuscleGroups)
    {
        <a asp-action="Index" asp-route-group="@g"
           class="btn btn-sm @(ViewBag.SelectedGroup != null && (MuscleGroup)ViewBag.SelectedGroup == g ? "btn-primary" : "btn-outline-primary")">
            @g
        </a>
    }
</div>

<div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 g-3">
    @foreach (var ex in Model)
    {
        <div class="col">
            <div class="card exercise-card h-100">
                <div class="card-body">
                    <h5 class="card-title">
                        <a asp-action="Details" asp-route-id="@ex.Id" class="text-decoration-none">@ex.Name</a>
                    </h5>
                    <span class="badge bg-secondary">@ex.MuscleGroup</span>
                    <span class="badge @(ex.TrackingType == TrackingType.Timer ? "bg-info" : "bg-success")">
                        @(ex.TrackingType == TrackingType.Timer ? "⏱ Timer" : "Reps")
                    </span>
                    @if (ex.Equipment != null)
                    {
                        <small class="text-muted d-block mt-1">@ex.Equipment</small>
                    }
                </div>
            </div>
        </div>
    }
</div>
