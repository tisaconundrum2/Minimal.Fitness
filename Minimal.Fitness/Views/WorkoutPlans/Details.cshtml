@model Minimal.Fitness.Models.WorkoutPlan
@using Minimal.Fitness.Models.Enums
@{
    ViewData["Title"] = Model.Name;
    var bumpSuggestions = ViewBag.BumpSuggestions as Dictionary<int, int>;
}

<nav aria-label="breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-controller="WorkoutPlans" asp-action="Index">Plans</a></li>
        <li class="breadcrumb-item active">@Model.Name</li>
    </ol>
</nav>

<h2>@Model.Name</h2>
@if (Model.Description != null) { <p class="text-muted">@Model.Description</p> }
<p class="text-muted mb-4">Rest between sets: @Model.RestSeconds seconds</p>

@foreach (var grp in Model.Exercises.OrderBy(e => e.SortOrder).GroupBy(e => e.Section))
{
    <h4 class="mt-4">@grp.Key</h4>
    <div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 g-3">
        @foreach (var pe in grp.OrderBy(e => e.SortOrder))
        {
            <div class="col">
                <div class="card exercise-card h-100">
                    <a asp-controller="Exercises" asp-action="Details" asp-route-id="@pe.ExerciseId"
                       class="text-decoration-none text-body">
                        @if (pe.Exercise.AnimationPath != null)
                        {
                            <div class="card-img-top frame-anim p-2" style="height:180px">
                                <img src="https://cdn.jsdelivr.net/npm/@@bryllim/workout-guide@@1.0.0/assets/@pe.Exercise.AnimationPath/frame-1.png" alt="@pe.Exercise.Name" />
                                <img src="https://cdn.jsdelivr.net/npm/@@bryllim/workout-guide@@1.0.0/assets/@pe.Exercise.AnimationPath/frame-2.png" alt="" loading="lazy" />
                                <img src="https://cdn.jsdelivr.net/npm/@@bryllim/workout-guide@@1.0.0/assets/@pe.Exercise.AnimationPath/frame-3.png" alt="" loading="lazy" />
                            </div>
                        }
                        <div class="card-body">
                            <h5 class="card-title">@pe.Exercise.Name</h5>
                            <span class="badge bg-secondary">@pe.Exercise.MuscleGroup</span>
                            <span class="badge @(pe.Exercise.TrackingType == TrackingType.Timer ? "bg-info" : "bg-success")">
                                @(pe.Exercise.TrackingType == TrackingType.Timer ? "⏱ Timer" : "Reps")
                            </span>
                            <div class="mt-2 small text-muted">
                                <span>@pe.DefaultSets sets</span>
                                <span class="mx-1">·</span>
                                @if (pe.Exercise.TrackingType == TrackingType.Timer)
                                { <span>@($"{pe.DefaultDurationSeconds}s ⏱")</span> }
                                else
                                { <span>@($"{pe.DefaultReps} reps")</span> }
                                @if (pe.DefaultWeight.HasValue)
                                {
                                    <span class="mx-1">·</span>
                                    <span>@($"{pe.DefaultWeight:F1} lbs")</span>
                                }
                            </div>
                        </div>
                    </a>
                    @if (bumpSuggestions != null && bumpSuggestions.TryGetValue(pe.ExerciseId, out var bump) && bump != 0)
                    {
                        var isTimer = pe.Exercise.TrackingType == TrackingType.Timer;
                        var isBodyweight = !isTimer && pe.DefaultWeight.GetValueOrDefault() == 0;
                        var repStep = (pe.DefaultReps ?? 10) >= 10 ? 5 : 1;
                        var label = isTimer ? "5 sec" : isBodyweight ? $"{repStep} reps" : "5 lbs";
                        <div class="card-footer bg-transparent border-top-0 pt-0 pb-2 px-3">
                            @if (bump > 0)
                            {
                                <form asp-controller="WorkoutPlans" asp-action="BumpLoad" method="post" class="d-inline">
                                    <input type="hidden" name="planId" value="@Model.Id" />
                                    <input type="hidden" name="workoutPlanExerciseId" value="@pe.Id" />
                                    <input type="hidden" name="direction" value="1" />
                                    <button type="submit" class="btn btn-sm btn-success">↑ +@label</button>
                                </form>
                            }
                            else
                            {
                                <form asp-controller="WorkoutPlans" asp-action="BumpLoad" method="post" class="d-inline">
                                    <input type="hidden" name="planId" value="@Model.Id" />
                                    <input type="hidden" name="workoutPlanExerciseId" value="@pe.Id" />
                                    <input type="hidden" name="direction" value="-1" />
                                    <button type="submit" class="btn btn-sm btn-danger">↓ -@label</button>
                                </form>
                            }
                        </div>
                    }
                </div>
            </div>
        }
    </div>
}

@if (User.Identity?.IsAuthenticated == true)
{
    @if (bumpSuggestions != null && bumpSuggestions.Values.Any(b => b != 0))
    {
        <form asp-controller="WorkoutPlans" asp-action="BumpAll" method="post" class="fab-bump" id="fab-bump" title="Apply all adjustments">
            <input type="hidden" name="planId" value="@Model.Id" />
            <button type="submit">
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="#fff" viewBox="0 0 16 16"><path d="M8 15A7 7 0 1 1 8 1a7 7 0 0 1 0 14m0 1A8 8 0 1 0 8 0a8 8 0 0 0 0 16"/><path d="m10.97 4.97-.02.022-3.473 4.425-2.093-2.094a.75.75 0 0 0-1.06 1.06L6.97 11.03a.75.75 0 0 0 1.079-.02l3.992-4.99a.75.75 0 0 0-1.071-1.05"/></svg>
            </button>
        </form>
    }

    <!-- Floating start button (visible on scroll) -->
    <a asp-controller="WorkoutSession" asp-action="Start" asp-route-planId="@Model.Id"
       class="fab-start" id="fab-start" title="Start Workout">
        <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" fill="#fff" viewBox="0 0 16 16"><path d="m11.596 8.697-6.363 3.692c-.54.313-1.233-.066-1.233-.697V4.308c0-.63.692-1.01 1.233-.696l6.363 3.692a.802.802 0 0 1 0 1.393"/></svg>
    </a>

    <div class="d-flex gap-2 mt-3 flex-wrap">
        <a asp-controller="WorkoutSession" asp-action="Start" asp-route-planId="@Model.Id"
           class="btn btn-primary btn-lg workout-btn">Start Workout</a>
        @if (Model.IsSeeded)
        {
            <a asp-action="Duplicate" asp-route-id="@Model.Id"
               class="btn btn-outline-secondary btn-lg workout-btn">Duplicate & Edit</a>
        }
        else
        {
            <a asp-action="Edit" asp-route-id="@Model.Id"
               class="btn btn-outline-secondary btn-lg workout-btn">Edit Plan</a>
        }
    </div>
}
