@model Minimal.Fitness.Models.WorkoutPlan
@using Minimal.Fitness.Models.Enums
@{
    ViewData["Title"] = Model.Name;
}

<nav aria-label="breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-controller="WorkoutPlans" asp-action="Index">Plans</a></li>
        <li class="breadcrumb-item active">@Model.Name</li>
    </ol>
</nav>

<h2>@Model.Name</h2>
@if (Model.Description != null) { <p class="text-muted">@Model.Description</p> }

@foreach (var grp in Model.Exercises.GroupBy(e => e.Section))
{
    <h4 class="mt-4">@grp.Key</h4>
    <table class="table">
        <thead>
            <tr>
                <th>Exercise</th>
                <th>Sets</th>
                <th>Target</th>
                <th>Weight</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var pe in grp.OrderBy(e => e.SortOrder))
            {
                <tr>
                    <td>
                        @if (pe.Exercise.AnimationPath != null)
                        {
                            <img src="https://cdn.jsdelivr.net/npm/@@bryllim/workout-guide@@1.0.0/assets/@pe.Exercise.AnimationPath/frame-1.png"
                                 class="exercise-img-sm" style="width:36px;height:36px;margin-right:6px" alt="" />
                        }
                        <a asp-controller="Exercises" asp-action="Details" asp-route-id="@pe.ExerciseId">@pe.Exercise.Name</a>
                    </td>
                    <td>@pe.DefaultSets</td>
                    <td>
                        @if (pe.Exercise.TrackingType == TrackingType.Timer)
                        { @($"{pe.DefaultDurationSeconds}s ⏱") }
                        else
                        { @($"{pe.DefaultReps} reps") }
                    </td>
                    <td>@(pe.DefaultWeight.HasValue ? $"{pe.DefaultWeight:F1} lbs" : "—")</td>
                </tr>
            }
        </tbody>
    </table>
}

@if (User.Identity?.IsAuthenticated == true)
{
    <div class="d-flex gap-2 mt-3">
        <a asp-controller="WorkoutSession" asp-action="Start" asp-route-planId="@Model.Id"
           class="btn btn-primary btn-lg workout-btn">Start Workout</a>
        @if (!Model.IsSeeded)
        {
            <a asp-action="Edit" asp-route-id="@Model.Id"
               class="btn btn-outline-secondary btn-lg workout-btn">Edit Plan</a>
        }
    </div>
}
