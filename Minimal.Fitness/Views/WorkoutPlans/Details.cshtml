@model Minimal.Fitness.Models.WorkoutPlan
@using Minimal.Fitness.Models.Enums
@{
    ViewData["Title"] = Model.Name;
}

<nav aria-label="breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-action="Index">Plans</a></li>
        <li class="breadcrumb-item active">@Model.Name</li>
    </ol>
</nav>

<h2>@Model.Name</h2>
@if (Model.Description is not null)
{
    <p class="text-muted">@Model.Description</p>
}

@foreach (var grp in Model.Exercises.GroupBy(e => e.Section))
{
    <h4 class="mt-4 mb-2">@grp.Key</h4>
    <div class="table-responsive">
        <table class="table table-hover">
            <thead>
                <tr>
                    <th>Exercise</th>
                    <th>Sets</th>
                    <th>Target</th>
                    <th>Weight</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var pe in grp.OrderBy(e => e.SortOrder))
                {
                    <tr>
                        <td>
                            <a asp-controller="Exercises" asp-action="Details" asp-route-id="@pe.ExerciseId">
                                @pe.Exercise.Name
                            </a>
                        </td>
                        <td>@pe.DefaultSets</td>
                        <td>
                            @if (pe.Exercise.TrackingType == TrackingType.Timer)
                            {
                                <span>@(pe.DefaultDurationSeconds)s ⏱</span>
                            }
                            else
                            {
                                <span>@(pe.DefaultReps) reps</span>
                            }
                        </td>
                        <td>@(pe.DefaultWeight.HasValue ? $"{pe.DefaultWeight} lbs" : "—")</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@if (User.Identity?.IsAuthenticated == true)
{
    <form asp-controller="WorkoutSession" asp-action="Start" method="post" class="mt-3">
        @Html.AntiForgeryToken()
        <input type="hidden" name="planId" value="@Model.Id" />
        <button type="submit" class="btn btn-success btn-lg w-100">▶ Start Workout</button>
    </form>
}
