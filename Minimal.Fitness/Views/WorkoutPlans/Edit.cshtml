@model Minimal.Fitness.Models.WorkoutPlan
@using Minimal.Fitness.Models.Enums
@{
    ViewData["Title"] = "Edit " + Model.Name;
    var exercises = (List<Minimal.Fitness.Models.Exercise>)ViewBag.Exercises;
}

<h2>Edit Plan</h2>

<form asp-action="Edit" asp-route-id="@Model.Id" method="post">
    @Html.AntiForgeryToken()

    <div class="mb-3">
        <label class="form-label">Plan Name</label>
        <input type="text" name="name" class="form-control" required value="@Model.Name" />
    </div>
    <div class="mb-3">
        <label class="form-label">Description</label>
        <textarea name="description" class="form-control" rows="2">@Model.Description</textarea>
    </div>

    <h4>Exercises</h4>
    <div id="exercise-list">
        @foreach (var pe in Model.Exercises)
        {
            var isTimer = pe.Exercise.TrackingType == TrackingType.Timer;
            <div class="card mb-2 exercise-row">
                <div class="card-body py-2">
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <strong>@pe.Exercise.Name</strong>
                        <button type="button" class="btn-close" onclick="this.closest('.exercise-row').remove()"></button>
                    </div>
                    <input type="hidden" name="exerciseIds" value="@pe.ExerciseId" />
                    <div class="row g-2">
                        <div class="col"><input type="text" name="sections" class="form-control form-control-sm" value="@pe.Section" /></div>
                        <div class="col-auto"><input type="number" name="sortOrders" class="form-control form-control-sm" value="@pe.SortOrder" style="width:60px" /></div>
                        <div class="col-auto"><input type="number" name="defaultSets" class="form-control form-control-sm" value="@pe.DefaultSets" style="width:60px" /></div>
                        @if (isTimer)
                        {
                            <div class="col-auto"><input type="number" name="defaultDurations" class="form-control form-control-sm" value="@pe.DefaultDurationSeconds" style="width:70px" /></div>
                            <input type="hidden" name="defaultReps" value="" />
                            <input type="hidden" name="defaultWeights" value="" />
                        }
                        else
                        {
                            <div class="col-auto"><input type="number" name="defaultReps" class="form-control form-control-sm" value="@pe.DefaultReps" style="width:70px" /></div>
                            <div class="col-auto"><input type="number" name="defaultWeights" class="form-control form-control-sm" value="@pe.DefaultWeight" style="width:70px" step="0.5" /></div>
                            <input type="hidden" name="defaultDurations" value="" />
                        }
                    </div>
                </div>
            </div>
        }
    </div>

    <div class="mb-3">
        <select id="exercise-picker" class="form-select">
            <option value="">Add an exercise...</option>
            @foreach (var ex in exercises)
            {
                <option value="@ex.Id" data-name="@ex.Name" data-tracking="@ex.TrackingType">@ex.Name (@ex.MuscleGroup)</option>
            }
        </select>
    </div>

    <button type="submit" class="btn btn-primary">Save Changes</button>
    <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-outline-secondary">Cancel</a>
</form>

@section Scripts {
<script>
    const picker = document.getElementById('exercise-picker');
    const list = document.getElementById('exercise-list');
    let exerciseIndex = list.children.length;

    picker.addEventListener('change', function () {
        if (!this.value) return;
        const opt = this.options[this.selectedIndex];
        const isTimer = opt.dataset.tracking === 'Timer';
        const i = exerciseIndex++;

        const html = `<div class="card mb-2 exercise-row">
            <div class="card-body py-2">
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <strong>${opt.dataset.name}</strong>
                    <button type="button" class="btn-close" onclick="this.closest('.exercise-row').remove()"></button>
                </div>
                <input type="hidden" name="exerciseIds" value="${this.value}" />
                <div class="row g-2">
                    <div class="col"><input type="text" name="sections" class="form-control form-control-sm" placeholder="Section" value="Main" /></div>
                    <div class="col-auto"><input type="number" name="sortOrders" class="form-control form-control-sm" value="${i}" style="width:60px" /></div>
                    <div class="col-auto"><input type="number" name="defaultSets" class="form-control form-control-sm" placeholder="Sets" value="3" style="width:60px" /></div>
                    ${isTimer
                        ? `<div class="col-auto"><input type="number" name="defaultDurations" class="form-control form-control-sm" placeholder="Sec" value="60" style="width:70px" /></div>
                           <input type="hidden" name="defaultReps" value="" /><input type="hidden" name="defaultWeights" value="" />`
                        : `<div class="col-auto"><input type="number" name="defaultReps" class="form-control form-control-sm" placeholder="Reps" value="10" style="width:70px" /></div>
                           <div class="col-auto"><input type="number" name="defaultWeights" class="form-control form-control-sm" placeholder="lbs" style="width:70px" step="0.5" /></div>
                           <input type="hidden" name="defaultDurations" value="" />`}
                </div>
            </div>
        </div>`;
        list.insertAdjacentHTML('beforeend', html);
        this.value = '';
    });
</script>
}
