@model IEnumerable<Minimal.Fitness.Models.WorkoutPlan>
@{
    ViewData["Title"] = "Workout Plans";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2 class="mb-0">Workout Plans</h2>
    @if (User.Identity?.IsAuthenticated == true)
    {
        <div class="d-flex gap-2">
            <a asp-action="RandomPlan" class="btn btn-outline-primary">🎲 Quick Mix</a>
            <a asp-action="Create" class="btn btn-primary">+ Create Plan</a>
        </div>
    }
</div>

<div class="row row-cols-1 row-cols-md-2 g-3" id="plans-list">
    @foreach (var plan in Model)
    {
        <div class="col plan-col">
            @if (User.Identity?.IsAuthenticated == true)
            {
                <div class="swipe-container" data-plan-id="@plan.Id" data-plan-name="@plan.Name">
                    <div class="swipe-delete-bg">Delete</div>
                    <div class="swipe-content position-relative">
                        <button type="button"
                                class="btn plan-delete-btn"
                                aria-label="Delete @plan.Name"
                                title="Delete @plan.Name">
                            ❌
                        </button>
                        <a asp-action="Details" asp-route-id="@plan.Id" class="card exercise-card h-100 text-decoration-none text-reset">
                            <div class="card-body">
                                <h5 class="card-title">@plan.Name</h5>
                                @if (plan.IsSeeded) { <span class="badge bg-primary">Starter</span> }
                                else { <span class="badge bg-secondary">Custom</span> }
                                @if (plan.Description != null) { <p class="card-text text-muted mt-2">@plan.Description</p> }
                                <p class="mb-0"><small class="text-muted">@plan.Exercises.Count exercises</small></p>
                            </div>
                        </a>
                    </div>
                </div>
            }
            else
            {
                <a asp-action="Details" asp-route-id="@plan.Id" class="card exercise-card h-100 text-decoration-none text-reset">
                    <div class="card-body">
                        <h5 class="card-title">@plan.Name</h5>
                        @if (plan.IsSeeded) { <span class="badge bg-primary">Starter</span> }
                        else { <span class="badge bg-secondary">Custom</span> }
                        @if (plan.Description != null) { <p class="card-text text-muted mt-2">@plan.Description</p> }
                        <p class="mb-0"><small class="text-muted">@plan.Exercises.Count exercises</small></p>
                    </div>
                </a>
            }
        </div>
    }
</div>

<!-- Delete confirmation modal -->
<div class="modal fade" id="deleteModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-sm">
        <div class="modal-content">
            <div class="modal-body text-center py-4">
                <h5 class="mb-2">Delete Plan?</h5>
                <p class="text-muted mb-0" id="deleteModalName"></p>
            </div>
            <div class="modal-footer justify-content-center border-0 pt-0">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-danger" id="confirmDeleteBtn">Delete</button>
            </div>
        </div>
    </div>
</div>

<style>
    .plan-delete-btn {
        position: absolute;
        top: 0.25rem;
        right: 0.25rem;
        z-index: 2;
        padding: 0;
        border: none;
        background: none;
        font-size: 1.1rem;
        line-height: 1;
        cursor: pointer;
    }
</style>

<script>
document.addEventListener('DOMContentLoaded', function() {
    const deleteThreshold = -80;
    let pendingContainer = null;
    const modalEl = document.getElementById('deleteModal');
    if (!modalEl) return;
    const modal = new bootstrap.Modal(modalEl);
    const modalName = document.getElementById('deleteModalName');
    const confirmBtn = document.getElementById('confirmDeleteBtn');
    const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value || '';

    function deletePlan(container) {
        const planId = container.dataset.planId;
        const content = container.querySelector('.swipe-content');
        content.classList.add('removing');
        fetch('@Url.Action("Delete", "WorkoutPlans")/' + planId, {
            method: 'POST',
            headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
            body: '__RequestVerificationToken=' + encodeURIComponent(token)
        }).then(() => {
            setTimeout(() => container.closest('.plan-col').remove(), 300);
        });
    }

    confirmBtn.addEventListener('click', () => {
        modal.hide();
        if (pendingContainer) deletePlan(pendingContainer);
        pendingContainer = null;
    });

    document.querySelectorAll('.plan-delete-btn').forEach(btn => {
        btn.addEventListener('click', (e) => {
            e.preventDefault();
            e.stopPropagation();
            pendingContainer = btn.closest('.swipe-container');
            if (!pendingContainer) return;
            modalName.textContent = pendingContainer.dataset.planName;
            modal.show();
        });
    });

    document.querySelectorAll('.swipe-container').forEach(container => {
        const content = container.querySelector('.swipe-content');
        let startX = 0, currentX = 0, swiping = false;

        content.addEventListener('touchstart', (e) => {
            startX = e.touches[0].clientX;
            currentX = 0;
            swiping = true;
            content.classList.add('swiping');
            container.classList.add('active-swipe');
        }, { passive: true });

        content.addEventListener('touchmove', (e) => {
            if (!swiping) return;
            currentX = e.touches[0].clientX - startX;
            if (currentX > 0) currentX = 0;
            content.style.transform = 'translateX(' + currentX + 'px)';
        }, { passive: true });

        content.addEventListener('touchend', () => {
            swiping = false;
            content.classList.remove('swiping');
            container.classList.remove('active-swipe');
            content.style.transform = '';
            if (currentX < deleteThreshold) {
                pendingContainer = container;
                modalName.textContent = container.dataset.planName;
                modal.show();
            }
        });
    });
});
</script>
@Html.AntiForgeryToken()
